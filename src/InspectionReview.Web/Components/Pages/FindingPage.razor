@page "/findings/{Id:int}"
@inject FindingService FindingService
@inject EditLockService EditLocks
@inject NavigationManager Navigation
@inject TimeProvider Clock
@implements IAsyncDisposable

<PageTitle>@(string.IsNullOrWhiteSpace(finding?.Title) ? "Finding" : finding.Title)</PageTitle>

@if (!loaded)
{
    <p><em>Loading…</em></p>
}
else if (finding is null)
{
    <h1>Finding not found</h1>
    <p><a href="">← Back to inspections</a></p>
}
else
{
    <p><a href="inspections/@finding.InspectionId">← Back to @finding.InspectionReference</a></p>

    <h1>
        @(string.IsNullOrWhiteSpace(finding.Title) ? "(untitled)" : finding.Title)
        <FindingStateBadge State="finding.State" />
    </h1>
    <p class="text-muted small">
        @finding.InspectionReference · created by @finding.CreatedBy on @finding.CreatedAt.ToString("yyyy-MM-dd")
        · updated @finding.UpdatedAt.ToString("yyyy-MM-dd HH:mm") UTC
        · <a href="findings/@finding.Id/history">History</a>
    </p>

    @if (finding.ReturnComment is not null && finding.State == FindingState.Returned)
    {
        <div class="alert alert-warning">
            <p class="mb-2"><strong>Returned by the reviewer:</strong> @finding.ReturnComment</p>
            @if (finding.CanRevise)
            {
                <button type="button" class="btn btn-warning" disabled="@busy" @onclick="ReviseAsync">Revise</button>
            }
        </div>
    }
    else if (finding.ReturnComment is not null && finding.State == FindingState.Draft)
    {
        <div class="alert alert-info">
            <strong>Reviewer's comment on the last submission:</strong> @finding.ReturnComment
        </div>
    }

    @if (!finding.CanEdit && finding.LockedBy is { } holder)
    {
        <div class="alert alert-secondary">
            Being edited by <strong>@(holder.DisplayName ?? "another inspector")</strong>
            since @holder.LockedAt.ToString("HH:mm") UTC. You can view it, but not edit it until they're done.
        </div>
    }

    @if (LockWarning() is { } lockWarning)
    {
        <div class="alert alert-warning">@lockWarning</div>
    }

    @if (statusMessage is not null)
    {
        <div class="alert alert-success">@statusMessage</div>
    }
    @if (errorMessage is not null)
    {
        <div class="alert alert-danger">
            @errorMessage
            @if (needsReload)
            {
                <button type="button" class="btn btn-sm btn-outline-danger ms-2" @onclick="ReloadAsync">Reload</button>
            }
        </div>
    }

    @if (finding.CanApprove || finding.CanReturn)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5">Review</h2>
                @if (finding.CanApprove)
                {
                    <button type="button" class="btn btn-success mb-3" disabled="@busy" @onclick="ApproveAsync">Approve</button>
                }
                @if (finding.CanReturn)
                {
                    <label for="return-comment" class="form-label d-block">Return to inspector</label>
                    <textarea id="return-comment" class="form-control mb-2" rows="3" disabled="@busy"
                              placeholder="What should the inspector change?"
                              @bind="returnComment" @bind:event="oninput"></textarea>
                    <button type="button" class="btn btn-outline-warning" disabled="@busy" @onclick="ReturnAsync">
                        Return to inspector
                    </button>
                }
            </div>
        </div>
    }

    @if (finding.CanEdit)
    {
        <FindingForm Model="model" AvailableDocuments="finding.AvailableDocuments" Busy="busy"
                     OnSaveDraft="SaveDraftAsync" OnSubmit="SubmitAsync" />
    }
    else
    {
        <h2 class="h5">Supporting documents</h2>
        @if (finding.LinkedDocuments.Count == 0)
        {
            <p class="text-muted">None linked.</p>
        }
        else
        {
            <ul>
                @foreach (var document in finding.LinkedDocuments)
                {
                    <li>@document.FileName <span class="text-muted">(@document.DocumentType)</span></li>
                }
            </ul>
        }

        <h2 class="h5">Finding</h2>
        <p style="white-space: pre-wrap">@(string.IsNullOrWhiteSpace(finding.Text) ? "(no text yet)" : finding.Text)</p>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    private FindingDetail? finding;
    private FindingFormModel model = new();
    private Guid version;   // the copy on screen; sent with every save
    private bool loaded;
    private bool busy;
    private string? errorMessage;
    private string? statusMessage;
    private string? returnComment;
    private bool needsReload;
    private int? lockedId;   // the finding this page holds the lock for
    private ITimer? lockWarningTimer;

    protected override async Task OnParametersSetAsync()
    {
        // Wait for the interactive render: the prerendered copy is thrown away, and would take and drop the lock.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        // Re-render now and then so the lock warning appears without a click.
        lockWarningTimer ??= Clock.CreateTimer(
            _ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));

        if (lockedId is int previous && previous != Id)
        {
            await ReleaseLockAsync();
        }

        loaded = false;
        errorMessage = null;
        statusMessage = null;
        needsReload = false;
        await LoadAsync();
        loaded = true;
    }

    private async Task LoadAsync()
    {
        finding = await FindingService.GetFindingAsync(Id);

        if (finding is { CouldEdit: true, CanEdit: false } && (await TryAcquireLockAsync()).Acquired)
        {
            finding = await FindingService.GetFindingAsync(Id);
        }
        lockedId = finding?.CanEdit == true ? Id : null;

        if (finding is not null)
        {
            version = finding.Version;
            model = new FindingFormModel
            {
                Title = finding.Title,
                Text = finding.Text,
                DocumentIds = finding.LinkedDocuments.Select(d => d.Id).ToHashSet(),
            };
        }
    }

    private string? LockWarning()
    {
        if (finding is not { CanEdit: true, LockedBy: { } myLock })
        {
            return null;
        }

        var now = Clock.GetUtcNow().UtcDateTime;
        if (now < myLock.ExpiresAt - EditLockService.WarningBefore)
        {
            return null;
        }

        return now < myLock.ExpiresAt
            ? $"Your edit lock expires at {myLock.ExpiresAt:HH:mm} UTC. Save your draft to keep it."
            : "Your edit lock has expired. Save your draft to take it back, if nobody else has.";
    }

    // The state may have changed since the page loaded; then just stay read-only.
    private async Task<LockResult> TryAcquireLockAsync()
    {
        try
        {
            return await EditLocks.TryAcquireAsync(Id);
        }
        catch (UnauthorizedAccessException)
        {
            return new LockResult(false, null);
        }
    }

    // Drops unsaved changes on purpose: the user asked for the latest version.
    private async Task ReloadAsync()
    {
        errorMessage = null;
        statusMessage = null;
        needsReload = false;
        await LoadAsync();
    }

    private Task SaveDraftAsync() => RunAsync("Draft saved.", async () =>
        version = await FindingService.UpdateDraftAsync(Id, version, model.Title, model.Text, model.DocumentIds));

    // Save first, so what's submitted is what's on screen.
    private Task SubmitAsync() => RunAsync("Submitted for review.", async () =>
    {
        version = await FindingService.UpdateDraftAsync(Id, version, model.Title, model.Text, model.DocumentIds);
        await FindingService.SubmitAsync(Id, version);
    });

    private Task ReviseAsync() => RunAsync("Back in Draft. Make your changes, then submit again.", () =>
        FindingService.ReviseAsync(Id));

    // Show refusals as a message instead of crashing the circuit.
    private Task ApproveAsync() => ReviewAsync("approved", () => FindingService.ApproveAsync(Id));

    private Task ReturnAsync()
    {
        // Quick message only; the service enforces this too.
        if (string.IsNullOrWhiteSpace(returnComment))
        {
            errorMessage = "Enter a comment for the inspector.";
            return Task.CompletedTask;
        }

        return ReviewAsync("returned", () => FindingService.ReturnAsync(Id, returnComment));
    }

    // On failure (e.g. someone else already approved it), reload so the buttons match the real state.
    private async Task ReviewAsync(string done, Func<Task> action)
    {
        busy = true;
        errorMessage = null;
        statusMessage = null;
        try
        {
            await action();
            Navigation.NavigateTo($"review?done={done}");
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or ArgumentException or InvalidOperationException)
        {
            await LoadAsync();
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RunAsync(string successMessage, Func<Task> action)
    {
        busy = true;
        errorMessage = null;
        statusMessage = null;
        try
        {
            await RetakeLockIfExpiredAsync(action);
            await LoadAsync();
            statusMessage = successMessage;
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or ArgumentException or InvalidOperationException)
        {
            errorMessage = ex.Message;
            needsReload = ex.Message is FindingService.ConcurrencyMessage or FindingService.LockLostMessage;
        }
        finally
        {
            busy = false;
        }
    }

    // The lock expired before the user saved. Take it back if nobody else has and save again with the
    // same Version: if anyone changed the finding meanwhile, the Version check still refuses the save.
    private async Task RetakeLockIfExpiredAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (InvalidOperationException ex) when (ex.Message == FindingService.LockLostMessage)
        {
            var result = await TryAcquireLockAsync();
            if (!result.Acquired)
            {
                lockedId = null;
                // Not a Reload: that would throw away the text still in the form.
                var holder = result.HeldBy is { } h
                    ? $"{h.DisplayName ?? "Another inspector"} has been editing it since {h.LockedAt:HH:mm} UTC"
                    : "someone else is editing it now";
                throw new InvalidOperationException(
                    $"Your edit lock expired and {holder}. Your changes are not saved; copy them before leaving this page.");
            }

            lockedId = Id;
            await action();
        }
    }

    private async Task ReleaseLockAsync()
    {
        if (lockedId is int id)
        {
            lockedId = null;
            await EditLocks.ReleaseAsync(id);
        }
    }

    // Best effort: if this fails (e.g. the connection is gone), the lock still expires after 30 minutes.
    public async ValueTask DisposeAsync()
    {
        lockWarningTimer?.Dispose();
        try
        {
            await ReleaseLockAsync();
        }
        catch (Exception)
        {
        }
    }
}
