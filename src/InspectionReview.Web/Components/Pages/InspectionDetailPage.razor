@page "/inspections/{Id:int}"
@inject InspectionService InspectionService
@inject FindingService FindingService

<PageTitle>@(inspection?.Reference ?? "Inspection")</PageTitle>

@if (!loaded)
{
    <p><em>Loading…</em></p>
}
else if (inspection is null)
{
    <h1>Inspection not found</h1>
    <p><a href="">← Back to inspections</a></p>
}
else
{
    <p><a href="">← Back to inspections</a></p>

    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h1>@inspection.Reference</h1>
            <p class="text-muted">@inspection.Title · @inspection.FirmName</p>
        </div>
        @if (inspection.CanCreateFinding)
        {
            <a class="btn btn-success" href="inspections/@inspection.Id/findings/new">New finding</a>
        }
    </div>

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (inspection.IsRecused)
    {
        <div class="alert alert-secondary">You are recused from @inspection.FirmName. View only.</div>
    }
    else if (inspection.NeedsIndependenceConfirmation)
    {
        <div class="alert alert-warning">
            <p class="mb-2">
                Before you can record findings, confirm that you are independent of @inspection.FirmName.
                If you can't judge this firm fairly, recuse yourself instead.
            </p>
            <button type="button" class="btn btn-primary me-2" disabled="@busy" @onclick="ConfirmIndependenceAsync">
                Confirm independence
            </button>
            <button type="button" class="btn btn-outline-danger" disabled="@busy" @onclick="() => confirmingRecusal = true">
                Recuse from this firm
            </button>
        </div>
    }
    else if (inspection.CanRecuse)
    {
        <p class="small">
            <button type="button" class="btn btn-link btn-sm p-0" disabled="@busy" @onclick="() => confirmingRecusal = true">
                Recuse from this firm
            </button>
        </p>
    }

    @if (confirmingRecusal)
    {
        <div class="alert alert-danger">
            <p class="mb-2">
                Recuse yourself from @inspection.FirmName? You'll still be able to view all of its inspections,
                but you won't be able to edit any of them. This can't be undone here.
            </p>
            <button type="button" class="btn btn-danger me-2" disabled="@busy" @onclick="RecuseAsync">Yes, recuse</button>
            <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="() => confirmingRecusal = false">Cancel</button>
        </div>
    }

    <h2 class="h4 mt-4">Documents</h2>

    @if (inspection.Documents.Count == 0)
    {
        <p>No documents to show.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>File name</th>
                    <th>Type</th>
                    <th>Uploaded by</th>
                    <th>Uploaded</th>
                    @if (inspection.ShowDocumentStatus)
                    {
                        <th>Status</th>
                        <th>Rejection reason</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var document in inspection.Documents)
                {
                    <tr>
                        <td>@document.FileName</td>
                        <td>@document.DocumentType</td>
                        <td>@document.UploadedBy</td>
                        <td>@document.UploadedAt.ToString("yyyy-MM-dd")</td>
                        @if (inspection.ShowDocumentStatus)
                        {
                            var (css, label) = StatusTag(document.Status);
                            <td><span class="badge @css">@label</span></td>
                            <td>@document.RejectionReason</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }

    @* null = findings aren't shown to this user. *@
    @if (findings is not null)
    {
        <h2 class="h4 mt-4">Findings</h2>

        @if (findings.Count == 0)
        {
            <p>No findings yet.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>State</th>
                        <th>Updated</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var finding in findings)
                    {
                        <tr>
                            <td>
                                <a href="findings/@finding.Id">
                                    @(string.IsNullOrWhiteSpace(finding.Title) ? "(untitled)" : finding.Title)
                                </a>
                            </td>
                            <td><FindingStateBadge State="finding.State" /></td>
                            <td>@finding.UpdatedAt.ToString("yyyy-MM-dd HH:mm") UTC</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    private InspectionDetail? inspection;
    private IReadOnlyList<FindingListItem>? findings;
    private bool loaded;
    private bool busy;
    private bool confirmingRecusal;
    private string? errorMessage;

    // Not OnInitializedAsync: Blazor reuses this component when only Id changes.
    protected override async Task OnParametersSetAsync()
    {
        loaded = false;
        errorMessage = null;
        confirmingRecusal = false;
        await LoadAsync();
        loaded = true;
    }

    private async Task LoadAsync()
    {
        inspection = await InspectionService.GetInspectionDetailAsync(Id);
        findings = inspection is null ? null : await FindingService.GetFindingsForInspectionAsync(Id);
    }

    private Task ConfirmIndependenceAsync() =>
        RunAsync(() => InspectionService.ConfirmIndependenceAsync(Id));

    private Task RecuseAsync() =>
        RunAsync(() => InspectionService.RecuseAsync(inspection!.FirmId));

    // Show refusals as a message instead of crashing the circuit.
    private async Task RunAsync(Func<Task> action)
    {
        busy = true;
        errorMessage = null;
        try
        {
            await action();
            confirmingRecusal = false;
            await LoadAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private static (string Css, string Label) StatusTag(DocumentStatus? status) => status switch
    {
        DocumentStatus.Accepted => ("bg-success", "Accepted"),
        DocumentStatus.Rejected => ("bg-danger", "Rejected"),
        DocumentStatus.PendingCheck => ("bg-secondary", "Pending check"),
        _ => ("", ""),
    };
}
